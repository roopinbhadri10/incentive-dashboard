# Production build config (CloudFront deploy).
# On CloudFront there is no dev proxy and no netlify.toml redirects, so the
# frontend must call the backends directly (cross-origin). These override the
# relative dev-proxy defaults in src/config/incentiveApi.ts and
# src/lib/saleshubApi.ts.
#
# NOTE: cross-origin requests require the backends to send CORS headers for
# https://salesincentive.salescode.ai. api.salescodeai.com already does;
# incentive-uat.salescode.ai must add Access-Control-Allow-Origin (see README).

# Incentive backend — rules, programme analytics and UI configs all live here.
# The paths under /v1 are fixed by the API contract, so this one base URL is the
# only thing to set. Anything left unset falls back to the relative dev-proxy
# path, which CloudFront answers with index.html instead of JSON.
VITE_INCENTIVE_API_BASE_URL=https://incentive-uat.salescode.ai/v1

# SalesHub master data — a different host, so it stays separate.
VITE_SALESHUB_BASE_URL=https://api.salescodeai.com
